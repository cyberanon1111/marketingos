# ─────────────────────────────────────────────────────────────────
# MarketingOS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL Database ──────────────────────────────────────────
# A new Neon project works well (same pattern as ../vdr-scorecard).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (Google Cloud Console → APIs & Services → Credentials) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Roles ─────────────────────────────────────────────────────────
# Comma-separated emails that get the MANAGER role on first sign-in.
MANAGER_EMAILS="tanishkaverma39@gmail.com"

# ── Dev-only sign-in bypass ─────────────────────────────────────────
# When true (and NODE_ENV !== "production"), adds a "pick a seeded user"
# credentials provider on the sign-in page so you can test without Google OAuth.
ENABLE_DEV_LOGIN="true"
